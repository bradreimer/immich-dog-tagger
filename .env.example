# Configuration
#
# Two ways to configure Immich, pick one:
#
# 1. This IMMICH_* block (below). Simplest for a single account.
# 2. A JSON config file (config.example.json), mounted at the path CONFIG_FILE names. Needed
#    for more than one Immich account, and generally preferred going forward -- see
#    docs/deployment.md "Immich configuration". If that file exists, it wins outright and this
#    IMMICH_* block is ignored (a startup log line says so).
#
# IMMICH_URL is how this app's backend reaches the Immich API (server to server).
IMMICH_URL=https://immich.example.com
IMMICH_API_KEY=replace-me

# IMMICH_EXTERNAL_URL is the address your browser uses for Immich, behind the
# "View in Immich" links in the review UI. Only set it when it differs from
# IMMICH_URL -- e.g. IMMICH_URL is a Docker-internal hostname like
# http://immich-server:2283. Leave it empty to reuse IMMICH_URL.
# IMMICH_EXTERNAL_URL=https://immich.example.com

# IMMICH_TIMEOUT_SECONDS bounds how long this app waits on any single Immich API request
# (default 60s). Bulk sync writes (tagging/albuming many assets at once) can legitimately take
# Immich a while to process; raise this if sync fails with a timeout on a large library.
# IMMICH_TIMEOUT_SECONDS=60

# CONFIG_FILE names the JSON config file's path (see option 2 above). Not needed when running
# from source unless you're adopting the JSON file -- uncomment and point it at a copy of
# config.example.json to opt in. docker-compose.yml sets this for the container automatically.
# CONFIG_FILE=./config.json

# App Settings (Used when running locally outside Docker)
STATE_DIR=./data/state
CACHE_DIR=./data/cache
YOLO_MODEL=./models/yolo11m.pt
CROP_PADDING=0.15

# Docker Host Volume Mounts (Used by docker-compose)
HOST_STATE_DIR=./data/state
HOST_CACHE_DIR=./data/cache
HOST_MODEL_DIR=./data/models
# HOST_CONFIG_FILE points docker-compose at your JSON config file on the host (see option 2
# above). Leave unset/pointed at a nonexistent path to keep using the IMMICH_* variables.
# HOST_CONFIG_FILE=./config.json