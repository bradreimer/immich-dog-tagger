# Configuration
# IMMICH_URL is how this app's backend reaches the Immich API (server to server).
IMMICH_URL=https://immich.example.com
IMMICH_API_KEY=replace-me

# IMMICH_EXTERNAL_URL is the address your browser uses for Immich, behind the
# "View in Immich" links in the review UI. Only set it when it differs from
# IMMICH_URL -- e.g. IMMICH_URL is a Docker-internal hostname like
# http://immich-server:2283. Leave it empty to reuse IMMICH_URL.
# IMMICH_EXTERNAL_URL=https://immich.example.com

# IMMICH_TIMEOUT_SECONDS bounds how long this app waits on any single Immich API request
# (default 60s). Bulk sync writes (tagging/albuming many assets at once) can legitimately take
# Immich a while to process; raise this if sync fails with a timeout on a large library.
# IMMICH_TIMEOUT_SECONDS=60

# App Settings (Used when running locally outside Docker)
STATE_DIR=./data/state
CACHE_DIR=./data/cache
YOLO_MODEL=./models/yolo11n.pt
CROP_PADDING=0.15

# Docker Host Volume Mounts (Used by docker-compose)
HOST_STATE_DIR=./data/state
HOST_CACHE_DIR=./data/cache
HOST_MODEL_DIR=./data/models